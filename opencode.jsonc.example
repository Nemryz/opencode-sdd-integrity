{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "small_model": "opencode/mimo-v2.6-flash-free",
  "agents": {
    "spec": {
      "model": "opencode/mimo-v2.6-flash-free",
      "request": {
        "body": {
          "temperature": 0.1
        }
      }
    }
  },
  "permission": {
    "external_directory": {
      "~/.config/opencode/**": "allow"
    }
  }
}
