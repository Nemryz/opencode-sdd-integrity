{
  "packageManager": "npm",
  "reporters": [
    "html",
    "clear-text",
    "progress",
    "json"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.stryker.ts",
    "related": false
  },
  "coverageAnalysis": "perTest",
  "tsconfigFile": "tsconfig.json",
  "ignoreStatic": true,
  "mutate": [
    "tools/shared/errors.ts",
    "tools/shared/paths.ts",
    "tools/shared/checksums.ts",
    "tools/shared/atomic.ts",
    "tools/shared/locks.ts",
    "tools/shared/backups.ts",
    "tools/shared/warnings.ts",
    "tools/shared/frontmatter.ts",
    "tools/shared/diagnostics.ts",
    "tools/shared/types.ts",
    "tools/shared/schemas.ts",
    "tools/shared/state/plan.ts",
    "tools/shared/state/apply.ts",
    "tools/shared/state/recovery.ts",
    "tools/shared/state/paths.ts",
    "tools/shared/state/session.ts",
    "tools/shared/state/spec.ts",
    "tools/shared/state/config.ts",
    "tools/speckit-archive.ts",
    "tools/shared/snapshot/paths.ts",
    "tools/shared/snapshot/triggers.ts",
    "tools/shared/snapshot/manifest.ts",
    "tools/shared/snapshot/restore.ts",
    "tools/shared/snapshot/retention.ts",
    "tools/speckit-snapshot.ts",
    "tools/speckit-scaffold.ts",
    "tools/speckit-delta.ts",
    "tools/speckit-complexity.ts",
    "tools/speckit-audit.ts",
    "tools/speckit-clean.ts",
    "tools/speckit-health.ts",
    "tools/speckit-selfheal.ts",
    "tools/speckit-perf.ts",
    "tools/plugins/speckit-perfmon.ts",
    "tools/speckit-validate.ts",
    "tools/speckit-status.ts",
    "tools/speckit-approve.ts",
    "tools/speckit-phase.ts",
    "tools/speckit-config.ts",
    "tools/speckit-guard.ts",
    "tools/plugins/speckit-guard.ts",
    "tools/plugins/speckit-tools.ts",
    "plugins/speckit-doom-loop.ts",
    "plugins/speckit-events.ts",
    "plugins/speckit-guard.ts",
    "plugins/speckit-perfmon.ts",
    "plugins/speckit-tools.ts",
    "tools/plugins/speckit-events.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "timeoutMS": 120000,
  "concurrency": 1,
  "checkers": [
    "typescript"
  ],
  "ignorePatterns": [
    "node_modules",
    "reports",
    "stryker.conf.json",
    "stryker.config.ts",
    ".opencode",
    "specs",
    "templates",
    "docs"
  ]
}
